<Window x:Class="TurboSafeOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iClover Tweaks"
        Width="1320"
        Height="820"
        MinWidth="1100"
        MinHeight="680"
        Background="#07090F"
        Foreground="#F4F7FC"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7F8BA0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#111B2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="#2878F0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A8AFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1D5CB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="#0E141E"/>
            <Setter Property="Foreground" Value="#B8C2D1"/>
            <Setter Property="BorderBrush" Value="#263244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#151F2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="#0C1119"/>
            <Setter Property="Foreground" Value="#F3F6FB"/>
            <Setter Property="BorderBrush" Value="#1E2938"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#101A29"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#315F9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06080D" Offset="0"/>
                <GradientStop Color="#0A0F18" Offset="0.55"/>
                <GradientStop Color="#070A10" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#090C12" BorderBrush="#1C2430" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="11" Background="#132744">
                            <TextBlock Text="IC" Foreground="#67A8FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0">
                            <TextBlock Text="iCLOVER" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="TWEAKS" FontSize="8" FontWeight="Bold" Foreground="#586476" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Foreground="#485365" FontSize="9" FontWeight="Bold" Margin="23,13,0,7"/>
                        <Button Content="⌂   Dashboard" Tag="Dashboard" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="✓   Restore Point" Tag="Restore" Click="Menu_Click" Style="{StaticResource NavButton}"/>

                        <TextBlock Text="OPTIMIZATION" Foreground="#485365" FontSize="9" FontWeight="Bold" Margin="23,22,0,7"/>
                        <Button Content="⚙   Windows Tweaks" Tag="Windows" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="▣   Cleaner" Tag="Cleaner" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="⌁   Networking" Tag="Network" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="☷   Advanced" Tag="Advanced" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="⚙   Services" Tag="Services" Click="Menu_Click" Style="{StaticResource NavButton}"/>

                        <TextBlock Text="GAMING" Foreground="#485365" FontSize="9" FontWeight="Bold" Margin="23,22,0,7"/>
                        <Button Content="🎮   Game Mode" Tag="Gaming" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="◈   Task Manager" Tag="Tasks" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="▰   System Info" Tag="Info" Click="Menu_Click" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#0C1016" BorderBrush="#1A222D" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Margin="17">
                        <Ellipse Width="8" Height="8" Fill="#3BE477" VerticalAlignment="Center"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="SYSTEM ONLINE" FontSize="9" FontWeight="Bold" Foreground="#59DC83"/>
                            <TextBlock Text="Windows 10 / 11" FontSize="8" Foreground="#515B6B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="38,30,38,28">

                    <Grid Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="Optimization Center" FontSize="29" FontWeight="Bold"/>
                            <TextBlock x:Name="PageSubtitle" Text="A clean control center for Windows maintenance, gaming and diagnostics." Foreground="#697587" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0B1911" BorderBrush="#204C32" BorderThickness="1" CornerRadius="18" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#3BE477" Margin="0,0,7,0"/>
                                <TextBlock Text="READY" Foreground="#55DF82" FontSize="9" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#0C1119" BorderBrush="#202B3A" BorderThickness="1" CornerRadius="17" Padding="27" Margin="0,0,0,23">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PC OPTIMIZATION" Foreground="#5799FF" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Tune your PC with confidence." FontSize="27" FontWeight="Bold" Margin="0,7,0,4"/>
                                <TextBlock Text="Safe maintenance tools with clear actions and a restore-first workflow. No blind tweaks." Foreground="#707B8C" FontSize="11" MaxWidth="650" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
                                    <Button Content="OPTIMIZE PC   →" Click="Optimize_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="CREATE RESTORE POINT" Click="Restore_Click" Margin="9,0,0,0" Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0A0F17" BorderBrush="#1D2A3D" BorderThickness="1" CornerRadius="12" Padding="17" Margin="20,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="STATUS" Foreground="#596477" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="20" FontWeight="Bold" Margin="0,11,0,2"/>
                                    <TextBlock Text="Safe maintenance mode" Foreground="#626D7D" FontSize="9"/>
                                    <Border Height="1" Background="#1B2430" Margin="0,15,0,11"/>
                                    <TextBlock Text="NO CHANGE IS KEPT IF IT MAKES THINGS WORSE." Foreground="#5D9CF0" FontSize="8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="SYSTEM OVERVIEW" Foreground="#555E6D" FontSize="9" FontWeight="Bold" Margin="3,0,0,10"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0D1117" BorderBrush="#1D2530" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="#5E6878" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="CpuText" Text="Detecting..." FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Processor" Foreground="#4F5868" FontSize="8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0D1117" BorderBrush="#1D2530" BorderThickness="1" CornerRadius="12" Padding="15" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="GPU" Foreground="#5E6878" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="GpuText" Text="Detecting..." FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Graphics" Foreground="#4F5868" FontSize="8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0D1117" BorderBrush="#1D2530" BorderThickness="1" CornerRadius="12" Padding="15" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Foreground="#5E6878" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="RamText" Text="Detecting..." FontSize="12" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="RAM" Foreground="#4F5868" FontSize="8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#0D1117" BorderBrush="#1D2530" BorderThickness="1" CornerRadius="12" Padding="15" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="WINDOWS" Foreground="#5E6878" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="WindowsText" Text="Detecting..." FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Operating System" Foreground="#4F5868" FontSize="8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="OPTIMIZATION TOOLS" Foreground="#555E6D" FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="Real Windows utilities, grouped for quick access." Foreground="#6D7685" FontSize="11" Margin="0,4,0,11"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="128"/>
                            <RowDefinition Height="128"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Tag="Windows" Click="Card_Click" Style="{StaticResource CardButton}" Margin="0,0,7,7">
                            <StackPanel Margin="19">
                                <TextBlock Text="WINDOWS" Foreground="#5799FF" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Windows Tweaks" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/>
                                <TextBlock Text="Open Windows privacy and system settings." Foreground="#697382" FontSize="10"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" Tag="Gaming" Click="Card_Click" Style="{StaticResource CardButton}" Margin="7,0,0,7">
                            <StackPanel Margin="19">
                                <TextBlock Text="GAMING" Foreground="#5799FF" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Game Mode" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/>
                                <TextBlock Text="Open Windows gaming settings." Foreground="#697382" FontSize="10"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0" Tag="Network" Click="Card_Click" Style="{StaticResource CardButton}" Margin="0,7,7,0">
                            <StackPanel Margin="19">
                                <TextBlock Text="NETWORK" Foreground="#5799FF" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Network Tools" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/>
                                <TextBlock Text="Flush DNS and reset Winsock." Foreground="#697382" FontSize="10"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" Tag="Cleaner" Click="Card_Click" Style="{StaticResource CardButton}" Margin="7,7,0,0">
                            <StackPanel Margin="19">
                                <TextBlock Text="SYSTEM" Foreground="#5799FF" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="System Cleaner" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/>
                                <TextBlock Text="Clean temporary Windows files." Foreground="#697382" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="iClover Tweaks • Free Edition • Windows 10 / 11" Foreground="#3E4653" FontSize="9" HorizontalAlignment="Center" Margin="0,25,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>