<Window x:Class="TurboSafeOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TurboSafe Optimizer"
        Width="1280" Height="780" MinWidth="1050" MinHeight="680"
        Background="#070A10" Foreground="#F4F7FC" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8994A7"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="10,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#111A29"/><Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#246BCE"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="22,0"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3180ED"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1B55A4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0D141F"/><Setter Property="Foreground" Value="#B8C3D5"/>
            <Setter Property="BorderBrush" Value="#263347"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#142033"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#090C12" BorderBrush="#1C2532" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
                <StackPanel Margin="22,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="11" Background="#13243B"><TextBlock Text="TS" Foreground="#68A9FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="11,1,0,0"><TextBlock Text="TURBOSAFE" FontSize="17" FontWeight="Bold"/><TextBlock Text="OPTIMIZER" Foreground="#586476" FontSize="8" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Foreground="#465164" FontSize="9" FontWeight="Bold" Margin="24,12,0,7"/>
                        <Button Content="⌂   Dashboard" Tag="Dashboard" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <TextBlock Text="OPTIMIZATION" Foreground="#465164" FontSize="9" FontWeight="Bold" Margin="24,22,0,7"/>
                        <Button Content="◈   General Tweaks" Tag="General" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="▣   Cleaner" Tag="Cleaner" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="⌁   Networking" Tag="Networking" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <TextBlock Text="GAMING" Foreground="#465164" FontSize="9" FontWeight="Bold" Margin="24,22,0,7"/>
                        <Button Content="Game Mode" Tag="Gaming" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="▰   System Tools" Tag="System" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <TextBlock Text="SAFETY" Foreground="#465164" FontSize="9" FontWeight="Bold" Margin="24,22,0,7"/>
                        <Button Content="↻   Restore Point" Tag="Restore" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#0C1017" BorderBrush="#1B2430" BorderThickness="0,1,0,0">
                    <StackPanel Margin="18,12"><TextBlock Text="NO MEJORÓ = NO SE QUEDA" Foreground="#63A6FF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Conservative • Reversible • Windows" Foreground="#566172" FontSize="8" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="38,30,38,30">
                    <Grid Margin="0,0,0,25">
                        <StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="A professional control center for safe Windows optimization." Foreground="#6E788A" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0B1911" BorderBrush="#204C32" BorderThickness="1" CornerRadius="18" Padding="12,7">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#42E17D" Margin="0,0,7,0"/><TextBlock Text="SYSTEM ONLINE" Foreground="#5BDE87" FontSize="9" FontWeight="Bold"/></StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="#0C1119" BorderBrush="#202C3D" BorderThickness="1" CornerRadius="17" Padding="26" Margin="0,0,0,23">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WINDOWS OPTIMIZATION CENTER" Foreground="#5B9EFF" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Your PC. Tuned safely." FontSize="29" FontWeight="Bold" Margin="0,8,0,5"/>
                                <TextBlock Text="Scan your system, clean temporary data and use controlled Windows maintenance tools from one professional dashboard." Foreground="#717C8D" FontSize="12" MaxWidth="690" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="SCAN &amp; ANALYZE  →" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/><Button Content="CREATE RESTORE POINT" Click="Restore_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/></StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0A0F17" BorderBrush="#1D2A3D" BorderThickness="1" CornerRadius="13" Padding="17" Margin="20,0,0,0">
                                <StackPanel><TextBlock Text="STATUS" Foreground="#596477" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="READY" FontSize="22" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="No automatic risky tweaks." Foreground="#626D7D" FontSize="9"/><Border Height="1" Background="#1B2430" Margin="0,17,0,11"/><TextBlock Text="Restore before major changes" Foreground="#5FA4FF" FontSize="9"/></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="SYSTEM OVERVIEW" Foreground="#566172" FontSize="9" FontWeight="Bold" Margin="2,0,0,10"/>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0D1219" BorderBrush="#1D2734" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,5,0"><StackPanel><TextBlock Text="CPU" Foreground="#5D6879" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="CpuValue" Text="Detecting..." FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="Processor" Foreground="#4F5968" FontSize="8" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Background="#0D1219" BorderBrush="#1D2734" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5,0"><StackPanel><TextBlock Text="GPU" Foreground="#5D6879" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="GpuValue" Text="Detecting..." FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="Graphics" Foreground="#4F5968" FontSize="8" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Grid.Column="2" Background="#0D1219" BorderBrush="#1D2734" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5,0"><StackPanel><TextBlock Text="MEMORY" Foreground="#5D6879" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="MemoryValue" Text="Detecting..." FontSize="12" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="RAM" Foreground="#4F5968" FontSize="8" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Grid.Column="3" Background="#0D1219" BorderBrush="#1D2734" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5,0,0,0"><StackPanel><TextBlock Text="WINDOWS" Foreground="#5D6879" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="WindowsValue" Text="Detecting..." FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="Operating System" Foreground="#4F5968" FontSize="8" Margin="0,4,0,0"/></StackPanel></Border>
                    </Grid>
                    <TextBlock Text="TOOLS" Foreground="#566172" FontSize="9" FontWeight="Bold"/><TextBlock Text="Real Windows utilities with explicit actions." Foreground="#6D7787" FontSize="11" Margin="0,5,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="118"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#0D1219" BorderBrush="#202A38" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,6,6"><Grid><StackPanel><TextBlock Text="CLEANUP" Foreground="#5B9EFF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Temporary Files" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/><TextBlock Text="Remove temporary files only. Personal files are not targeted." Foreground="#687383" FontSize="9" TextWrapping="Wrap"/></StackPanel><Button Content="CLEAN" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Clean_Click" Style="{StaticResource SecondaryButton}" Height="34" Padding="15,0"/></Grid></Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#0D1219" BorderBrush="#202A38" BorderThickness="1" CornerRadius="14" Padding="18" Margin="6,0,0,6"><Grid><StackPanel><TextBlock Text="NETWORK" Foreground="#5B9EFF" FontSize="9" FontWeight="Bold"/><TextBlock Text="DNS &amp; Winsock" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/><TextBlock Text="Flush DNS cache and reset Winsock with confirmation." Foreground="#687383" FontSize="9" TextWrapping="Wrap"/></StackPanel><Button Content="RUN" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Network_Click" Style="{StaticResource SecondaryButton}" Height="34" Padding="15,0"/></Grid></Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="#0D1219" BorderBrush="#202A38" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,6,6,0"><Grid><StackPanel><TextBlock Text="WINDOWS" Foreground="#5B9EFF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Game Mode" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/><TextBlock Text="Open the official Windows Game Mode settings." Foreground="#687383" FontSize="9" TextWrapping="Wrap"/></StackPanel><Button Content="OPEN" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Gaming_Click" Style="{StaticResource SecondaryButton}" Height="34" Padding="15,0"/></Grid></Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#0D1219" BorderBrush="#202A38" BorderThickness="1" CornerRadius="14" Padding="18" Margin="6,6,0,0"><Grid><StackPanel><TextBlock Text="SYSTEM" Foreground="#5B9EFF" FontSize="9" FontWeight="Bold"/><TextBlock Text="System Information" FontSize="17" FontWeight="Bold" Margin="0,6,0,3"/><TextBlock Text="Open Windows System Information for deeper diagnostics." Foreground="#687383" FontSize="9" TextWrapping="Wrap"/></StackPanel><Button Content="OPEN" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="System_Click" Style="{StaticResource SecondaryButton}" Height="34" Padding="15,0"/></Grid></Border>
                    </Grid>
                    <TextBlock Text="TurboSafe Optimizer • Windows 10/11 • v0.5.0" Foreground="#3E4755" FontSize="9" HorizontalAlignment="Center" Margin="0,26,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>